n          \"step_id\": \"given_4239b5529a086912\",\n          \"params\": {\n            \"correlation_id\": \"urn:mock:system\"\n          },\n          \"docstring\": null\n        },\n        {\n          \"keyword\": \"When\",\n          \"step_id\": \"when_ba50fd0c33eef7d8\",\n          \"params\": {\n            \"method_path\": \"/mock-gateway/v1/tariffs/recommended\",\n            \"server_name\": \"rest_mock\",\n            \"headers\": \"rqUid, rqTm, spName, systemId\",\n            \"file_path\": \"request_recommended.json\"\n          },\n          \"docstring\": \"Отправка REST запроса с заголовками и телом из файла.\"\n        },\n        {\n          \"keyword\": \"Then\",\n          \"step_id\": \"then_405998c015056401\",\n          \"params\": {\n            \"status_code\": 200,\n            \"file_path\": \"response_recommended.json\"\n          },\n          \"docstring\": null\n        },\n        {\n          \"keyword\": \"Given\",\n          \"step_id\": \"given_2618e327d900a1fc\",\n          \"params\": {\n            \"request_id\": \"contractIdInitial\"\n          },\n          \"docstring\": null\n        },\n        {\n          \"keyword\": \"Given\",\n          \"step_id\": \"given_2618e327d900a1fc\",\n          \"params\": {\n            \"request_id\": \"calcRequestId\"\n          },\n          \"docstring\": null\n        },\n        {\n          \"keyword\": \"Given\",\n          \"step_id\": \"given_2b0b75d2cb7a8e19\",\n          \"params\": {\n            \"client_id\": \"0.8\"\n          },\n          \"docstring\": null\n        },\n        {\n          \"keyword\": \"Given\",\n          \"step_id\": \"given_2b0b75d2cb7a8e19\",\n          \"params\": {\n            \"client_id\": \"5000000\"\n          },\n          \"docstring\": null\n        },\n        {\n          \"keyword\": \"When\",\n          \"step_id\": \"when_ba50fd0c33eef7d8\",\n          \"params\": {\n            \"method_path\": \"/mock-gateway/v1/calculation/