<idea-plugin>
  <idea-version since-build="241" until-build="261.*" />
  <id>com.spydr.plugin</id>
  <name>SpyDR Agent</name>
  <version>1.0.0</version>
  <vendor>SpyDR</vendor>
  <description><![CDATA[Интерактивный агент для автоматической генерации Gherkin .feature файлов
        из ручных тест-кейсов с помощью LLM. Пишет результат напрямую в файл проекта.]]></description>
  <depends>com.intellij.modules.platform</depends>
  <extensions defaultExtensionNs="com.intellij">
    <toolWindow id="SpyDR Agent" anchor="right" factoryClass="com.spydr.plugin.SpydrToolWindowFactory" icon="AllIcons.Actions.Execute" />
    <applicationConfigurable parentId="tools" instance="com.spydr.plugin.settings.SpydrSettingsConfigurable" id="com.spydr.plugin.settings" displayName="SpyDR Agent" />
    <applicationService serviceImplementation="com.spydr.plugin.settings.SpydrSettingsState" />
    <notificationGroup id="SpyDR Agent" displayType="BALLOON" />
  </extensions>
</idea-plugin>
